// Original rayslash module glyph geometry.
export component ModuleGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> icon-color;

    background: transparent;

    if root.kind == "calculator": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M7 2 H17 L21 6 V18 L17 22 H7 L3 18 V6 Z M7 6 H17 V10 H7 Z M7 14 H9 M12 14 H14 M17 13 V15 M7 18 H9 M12 18 H14 M17 17 V19";
        stroke: root.icon-color;
        stroke-width: 2px;
        fill: transparent;
    }

    if root.kind == "currency": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M4 8 H16 M13 5 L16 8 L13 11 M20 16 H8 M11 13 L8 16 L11 19";
        stroke: root.icon-color;
        stroke-width: 2px;
        fill: transparent;
    }

    if root.kind == "time": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3 L18 5 L21 11 L19 18 L13 21 L6 19 L3 13 L5 6 Z M12 7 V12 L16 14";
        stroke: root.icon-color;
        stroke-width: 2px;
        fill: transparent;
    }

    if root.kind == "timers": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 3 H18 M7 3 V6 C7 9 10 10 11 12 C10 14 7 15 7 18 V21 H17 V18 C17 15 14 14 13 12 C14 10 17 9 17 6 V3 M6 21 H18";
        stroke: root.icon-color;
        stroke-width: 2px;
        fill: transparent;
    }
}
